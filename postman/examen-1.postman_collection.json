                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"Tiene id y queda activo\", () => { pm.expect(j.id).to.be.a(\"number\"); pm.expect(j.activo).to.eql(true); });",
